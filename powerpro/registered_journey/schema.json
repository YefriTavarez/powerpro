        "reqd": 1,
        "in_list_view": 1
      },
      {
        "fieldname": "ends_at",
        "label": "Hasta",
        "fieldtype": "Datetime",
        "reqd": 1
      },
      {
        "fieldname": "status",
        "label": "Estado",
        "fieldtype": "Select",
        "options": "Borrador\nDocumentos Preparados",
        "read_only": 1,
        "default": "Borrador",
        "in_list_view": 1,
        "no_copy": 1
      },
      {
        "fieldname": "reason",
        "label": "Motivo",
        "fieldtype": "Small Text",
        "reqd": 1

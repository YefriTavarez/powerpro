  {
    "doctype": "DocType",
    "name": "Registro de Jornada",
    "module": "Custom",
    "custom": 1,
    "autoname": "format:JORN-{YYYY}-{#####}",
    "naming_rule": "Expression",
    "track_changes": 1,
    "allow_rename": 0,
    "search_fields": "reason,company",
    "sort_field": "modified",
    "sort_order": "DESC",
    "title_field": "journey_type",
    "show_title_field_in_link": 0,
    "fields": [
      {
        "fieldname": "intro",
        "label": "Registro de Jornada",
        "fieldtype": "HTML"
      },
      {
        "fieldname": "general",
        "label": "1. Jornada",
        "fieldtype": "Section Break"
      },
      {
        "fieldname": "company",
        "label": "Empresa",
        "fieldtype": "Link",
        "options": "Company",
        "reqd": 1
      },
      {
        "fieldname": "journey_type",
        "label": "Tipo de Jornada",
        "fieldtype": "Select",
        "options": "Horas Adicionales\nCambio de Turno\nCambio de Turno y Horas Adicionales",
        "reqd": 1,
        "in_list_view": 1,
        "default": "Horas Adicionales"
      },
      {
        "fieldname": "replacement_shift",
        "label": "Turno Sustituto",
        "fieldtype": "Link",
        "options": "Shift Type",
        "depends_on": "eval:doc.journey_type!=\"Horas Adicionales\"",
        "mandatory_depends_on": "eval:doc.journey_type!=\"Horas Adicionales\""
      },
      {
        "fieldname": "general_col",
        "label": "",
        "fieldtype": "Column Break"
      },
      {
        "fieldname": "starts_at",
        "label": "Desde",
